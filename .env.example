# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Database (Supabase Postgres via Prisma) ──────────────────────────────────
# Use the pooler connection for serverless (port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection for Prisma migrations (port 5432)
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ─── NOWPayments ─────────────────────────────────────────────────────────────
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Creator Wallet Addresses (configured in NOWPayments dashboard) ───────────
# These are for reference — actual payment addresses come from NOWPayments API.
# Set your wallet addresses in your NOWPayments account settings.
WALLET_BTC=your-btc-address
WALLET_ETH=your-eth-address
WALLET_SOL=your-sol-address
WALLET_XRP=your-xrp-address
WALLET_USDT_TRC20=your-usdt-trc20-address
