        </div>
      </div>
      <div class="item-body">
        <div class="item-type">${item.type}${item.adult?'<span class="badge-18">18+</span>':''}</div>
        <div class="item-title">${item.title}</div>
        <div class="item-desc">${item.desc}</div>
        <div class="item-footer">
          <div>
            <div class="item-price">$${item.price.toFixed(2)}</div>
            <div class="item-meta">${item.sales} purchases</div>
          </div>
          <button class="btn-buy" onclick="openModal(${item.id})">Unlock →</button>
        </div>
      </div>
    </div>
  `).join('');
}

function openModal(id){
  currentItem=items.find(i=>i.id===id);
  document.getElementById('modal-title').textContent='Unlock: '+currentItem.title;
  document.getElementById('modal-price').textContent='$'+currentItem.price.toFixed(2);
  document.getElementById('pay-section').style.display='block';
  document.getElementById('success-section').style.display='none';
  selectCryptoByName('BTC');
  document.getElementById('pay-modal').classList.add('open');
}

function closeModal(){document.getElementById('pay-modal').classList.remove('open')}

const addrs={BTC:'bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh',ETH:'0x71C7656EC7ab88b098defB751B7401B5f6d8976F',SOL:'7EcDhSYGxXyscszYEp35KHN8vvw3svAuLKTzXwCFLtV',XRP:'rHb9CJAWyB4rj91VRWn96DkukG4bwdtyTh',USDT:'TN3W4H6rK2ce4vX9YnFQHwKx7eNwnk1fX'};

function selectCrypto(el,sym){
  document.querySelectorAll('.ctab').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  currentCrypto=sym;
  const amt=(currentItem.price*rates[sym]);
  const display=amt<0.001?amt.toFixed(6):amt<1?amt.toFixed(4):amt.toFixed(2);
  document.getElementById('crypto-amount').textContent=display+' '+sym;
  document.getElementById('wallet-addr').textContent=addrs[sym];
}

function selectCryptoByName(sym){
  const tabs=document.querySelectorAll('.ctab');
  tabs.forEach(t=>{if(t.textContent.includes(sym))selectCrypto(t,sym)});
  tabs[0].click();
}

function copyAddr(){
  navigator.clipboard.writeText(addrs[currentCrypto]).catch(()=>{});
  const box=document.getElementById('addr-box');
  box.querySelector('.copy-hint').textContent='Copied!';
  setTimeout(()=>box.querySelector('.copy-hint').textContent='Copy',1500);
}

function simulatePayment(){
  document.getElementById('pay-section').style.display='none';
  const s=document.getElementById('success-section');
  s.style.display='block';
  document.getElementById('revealed-content').innerHTML=`<a href="${currentItem.content}" target="_blank">${currentItem.content} ↗</a>`;
}

renderItems();
</script>
