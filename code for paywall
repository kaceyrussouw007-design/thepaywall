];

const rates={BTC:0.000012,ETH:0.00034,SOL:0.092,XRP:14.5,USDT:1};
let currentItem=null,currentCrypto='BTC';

function renderItems(){
  document.getElementById('items').innerHTML=items.map(item=>`
    <div class="item-card">
      <div class="item-preview">
        <div style="font-size:4rem;opacity:0.15">${item.emoji}</div>
        <div class="blur-overlay">
