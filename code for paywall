  bars.innerHTML=vals.map((v,i)=>`<div class="bar${v===Math.max(...vals)?' accent':''}" style="height:${Math.max(4,(v/max)*100)}%" title="$${v}"></div>`).join('');
  labels.innerHTML=days.map(d=>`<div class="bar-label" style="flex:1">${d}</div>`).join('');
}

function showTab(name){
  document.querySelectorAll('[id^="tab-"]').forEach(el=>el.style.display='none');
  document.getElementById('tab-'+name).style.display='block';
  document.querySelectorAll('.sidebar-link').forEach(el=>el.classList.remove('active'));
  event.currentTarget.classList.add('active');
  if(name==='wallets') buildWallets();
}

